#!/usr/bin/env bash
# /!\ Need procps binaries

# system info:
#   6.0  kernel  225   tasks
#   90%  cpu     1.35  load
#   35%  memory  65°   temp

mem_warn=50  # %
cpu_warn=20  # %
temp_warn=60 # °c

source ../tools/colors.sh
ps=$(ps --ppid 2 -p 2 --deselect -o pid= | wc -l)
read -r _ _ load _ < /proc/loadavg
while read -r key value _; do
    case "${key}" in
        MemTotal:)     mem_total="${value}" ;;
        MemAvailable:) mem_avail="${value}" ;;
    esac
done < /proc/meminfo
mem=$(( 100 * (mem_total - mem_avail) / mem_total ))
cpus=(/sys/devices/system/cpu/cpu[0-9]*)
cpunb=${#cpus[@]}
cpu=$(../tools/cpu.sh)
IFS=. read -r kern_major kern_minor _ < /proc/sys/kernel/osrelease

# CPU sensor: first thermal zone or hwmon with a CPU type, else thermal_zone0
temp_file='/sys/class/thermal/thermal_zone0/temp'
for name_file in /sys/class/thermal/thermal_zone*/type /sys/class/hwmon/hwmon*/name; do
    [[ -r "${name_file}" ]] || continue
    read -r name < "${name_file}"
    case "${name}" in
        x86_pkg_temp|*cpu*) file="${name_file%/*}/temp" ;;
        k10temp)            file="${name_file%/*}/temp1_input" ;;
        *)                  continue ;;
    esac
    if [[ -r "${file}" ]]; then
        temp_file="${file}"
        break
    fi
done

#ps=$(c_if "${ps}" '<' '150')
mem_status=$(c_if  "${mem}"  '<' "${mem_warn}" '%')
load_status=$(c_if "${load}" '<' "${cpunb}")
cpu_status=$(c_if  "${cpu}"  '<' "${cpu_warn}" '%')

out=''
out+="${kern_major}.${kern_minor}|kernel|${ps}|tasks\n"
out+="${cpu_status}|cpu|${load_status}|load\n"
out+="${mem_status}|memory|"
if [[ -f "${temp_file}" ]]; then
    read -r temp < "${temp_file}"
    temp=$(c_if "$(( temp / 1000 ))" '<' "${temp_warn}" '°')
    out+="${temp}|temp\n"
fi

echo
echo 'system info:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'
