#!/usr/bin/env bash
# /!\ Need apt packages manager

# packages:
#   4 upgradable  2 security
#   3 cleanable   0 obsolete
#   ! reboot required

printf -v date '%(%Y%m%d)T' -1
data='../data/apt'
columns=2

source ../tools/colors.sh
[[ -r "${data}" ]] && source "${data}"

# One query per line: '<name>  <apt pattern>'
# Comment a line to disable
packages_query=(
  'upgradable  ?upgradable'
  'security    ?and(?upgradable,?security)'
  'cleanable   ?or(?garbage,?config-files)'
  'obsolete    ?obsolete'
#  'removable   ?garbage'
#  'residual    ?config-files'
)

if [[ "${lastupdate}" != "${date}" ]]; then
    # on update failure, keep lastupdate to retry next run
    apt-get -qq update && lastupdate="${date}"
    declare -A pkgs
    for entry in "${packages_query[@]}"; do
        label="${entry%% *}"
        query="${entry##* }"
        pkgs[${label}]=$(apt -qq list "${query}" 2>/dev/null | wc -l)
    done
    declare -p lastupdate pkgs > "${data}"
fi

out=''
for i in "${!packages_query[@]}"; do
    label="${packages_query[${i}]%% *}"
    value=$(c_if "${pkgs[${label}]}" '<' '1')
    out+="${value} ${label}|"
    (( (i+1) % columns == 0 )) && out+='\n'
done
if [[ -z "${out}" ]]; then
    out='none'
fi

echo
echo 'packages:'
echo -e "${out}" | column -ts '|' | sed 's/^/  /'

if [[ -f /run/reboot-required ]]; then
    echo -e "  ${bred}!${reset} reboot required"
fi

